# --- LLM (Groq, OpenAI-compatible) ---
GROQ_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Hindsight memory ---
# Local docker:  http://localhost:8888   (no api key needed)
# Hindsight Cloud: use the URL + API key from https://ui.hindsight.vectorize.io
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# hindsight | local  (local = JSON-file fallback so you can test without a server)
MEMORY_BACKEND=hindsight
BANK_PREFIX=meetprep
